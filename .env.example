# Copy this file to .env.local and fill in the values. .env.local is git-ignored.

# Qloo hackathon key (request: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
# Hackathon keys ONLY work against the hackathon base URL below.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM used by the agent: OpenAI through your ChatGPT subscription (no API key).
# One-time sign-in: npm run llm:login   (saves a git-ignored credential in .secrets/)
LLM_PROVIDER=chatgpt
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low
CHATGPT_AUTH_FILE=.secrets/chatgpt-auth.json
# "file" = the local file above (development). "redis" = Upstash (required on Vercel).
CHATGPT_AUTH_STORE=file

# This standalone repository defaults to the parallel three-plan engine. Set sequential only to run the control.
RECOMMENDATION_ARCHITECTURE=parallel

# Upstash Redis (optional locally): server-side cache of Qloo answers and finished runs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
