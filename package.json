{
  "name": "cultural-crash-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Translate cultural references, not just words, using Qloo's taste graph.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "live": "tsx --env-file-if-exists=.env.local",
    "eval:live": "tsx --env-file-if-exists=.env.local eval/run.ts",
    "eval:freeze": "tsx --env-file-if-exists=.env.local eval/freeze.ts",
    "eval:frozen": "tsx --env-file-if-exists=.env.local eval/run.ts --frozen",
    "eval:report": "tsx --env-file-if-exists=.env.local eval/report.ts",
    "eval:compare": "tsx --env-file-if-exists=.env.local eval/compare.ts",
    "eval:plausibility": "tsx --env-file-if-exists=.env.local eval/plausibility-run.ts",
    "scenario:intake": "tsx --env-file-if-exists=.env.local eval/scenario-intake.ts",
    "scenario:run": "tsx --env-file-if-exists=.env.local eval/scenario-run.ts",
    "scenario:compare": "tsx --env-file-if-exists=.env.local eval/scenario-compare.ts",
    "eval:fingerprint": "tsx eval/fingerprint.ts",
    "llm:login": "tsx --env-file-if-exists=.env.local scripts/chatgpt-login.ts",
    "llm:push-credential": "tsx --env-file-if-exists=.env.local scripts/push-chatgpt-credential.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
